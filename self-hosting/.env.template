NODE_ENV="production"
SELF_HOSTED="true"
BATCH_SIZE="5000"
BATCH_INTERVAL="10000"
ALLOW_REGISTRATION="false"
ALLOW_INVITATION="true"
# Will be replaced with the setup script
REDIS_URL="$REDIS_URL"
CLICKHOUSE_URL="$CLICKHOUSE_URL"
DATABASE_URL="$DATABASE_URL"
DATABASE_URL_DIRECT="$DATABASE_URL_DIRECT"
DASHBOARD_URL="$DASHBOARD_URL"
API_URL="$API_URL"
COOKIE_SECRET="$COOKIE_SECRET"
EMAIL_SENDER="$EMAIL_SENDER"
RESEND_API_KEY="$RESEND_API_KEY"

# --- Telemetry (metrics, logs, traces) -------------------------------------
# gigapipe shares the ClickHouse above, in its own database.
CLICKHOUSE_TELEMETRY_DB="openpanel_telemetry"
# Password for the constrained `gigapipe` ClickHouse user. Must match what
# clickhouse/init-db.sh created; change both together.
CLICKHOUSE_TELEMETRY_PASSWORD="$CLICKHOUSE_TELEMETRY_PASSWORD"
# HTTP credentials op-api uses to reach gigapipe. If either is empty gigapipe
# serves its write routes unauthenticated to the whole compose network, so the
# compose file refuses to start without them.
GIGAPIPE_USER="$GIGAPIPE_USER"
GIGAPIPE_PASSWORD="$GIGAPIPE_PASSWORD"
GIGAPIPE_URL="http://op-gigapipe:3100"
# One window for all signals until logs ship (P3). See 14-decisions.md D6/D7.
TELEMETRY_RETENTION_DAYS="30"
# Pin before production. `latest` is a moving schema contract.
# GIGAPIPE_IMAGE="ghcr.io/metrico/gigapipe:vX.Y.Z"
